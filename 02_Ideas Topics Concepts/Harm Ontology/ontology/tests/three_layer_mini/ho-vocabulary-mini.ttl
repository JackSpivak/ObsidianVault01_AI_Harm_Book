    owl:annotatedProperty skos:relatedMatch ;
    owl:annotatedSource phil:circleHumanity ;
    owl:annotatedTarget int:worldcentric .

[] a owl:Axiom ;
    rdfs:comment "Wilber equates them (primary text)"@en ;
    owl:annotatedProperty skos:exactMatch ;
    owl:annotatedSource int:worldcentric ;
    owl:annotatedTarget psy:universalCare .

[] a owl:Axiom ;
    rdfs:comment "the same gap, located in names and titles"@en ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource hov:congruence ;
    owl:annotatedTarget phil:zhengming .

[] a owl:Axiom ;
    rdfs:comment "stages of widening care, the most direct match to the hub's definition"@en ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource hov:developmentalAltitude ;
    owl:annotatedTarget psy:careStages .

[] a owl:Axiom ;
    rdfs:comment "Claude's proposal; both centre on the self"@en ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedSource int:egocentric ;
    owl:annotatedTarget psy:preConventional .

[] a owl:Axiom ;
    rdfs:comment "Wilber equates them (primary text)"@en ;
    owl:annotatedProperty skos:exactMatch ;
    owl:annotatedSource int:egocentric ;
    owl:annotatedTarget psy:selfish .

[] a owl:Axiom ;
    rdfs:comment "one kind of incongruence, deliberate euphemism"@en ;
