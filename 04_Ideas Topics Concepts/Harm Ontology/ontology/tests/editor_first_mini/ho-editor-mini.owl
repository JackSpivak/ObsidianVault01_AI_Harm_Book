  <rdf:Description rdf:nodeID="nc603006b11d14f24b14e156d4b73f71fb21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://example.org/harm-ontology/v3-editor-mini/schema#Agent"/>
    <owl:onProperty rdf:resource="https://example.org/harm-ontology/v3-editor-mini/schema#authority"/>
