@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hosh: <https://example.org/harm-ontology/v3-mini/profiles#> .
@prefix hov: <https://example.org/harm-ontology/v3-mini/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/harm-ontology/v3-mini/ho-profiles-mini> a owl:Ontology ;
    dcterms:title "Harm Ontology mini example: profiles layer (SHACL, hosh:)"@en ;
    rdfs:comment "DEMO shapes only, to show the layer. They check that the vocabulary examples are complete. They are NOT design decisions and not the LegalInstitutional / LearnedModel profiles of PerspectiveStructure 0.02."@en ;
    owl:imports <https://example.org/harm-ontology/v3-mini/ho-schema-mini> ;
    owl:versionIRI <https://example.org/harm-ontology/v3-mini/ho-profiles-mini/0.1> ;
    owl:versionInfo "mini example 0.1 (2026-11-18). Not the v3 release." .

hosh:HubShape a sh:NodeShape ;
    rdfs:label "Hub completeness (demo)"@en ;
    sh:property [ sh:minCount 1 ;
            sh:path hov:status ],
        [ sh:minCount 1 ;
            sh:path hov:explanation ],
        [ sh:minCount 1 ;
            sh:path skos:definition ],
        [ sh:minCount 1 ;
            sh:path hov:documents ],
        [ sh:minCount 1 ;
            sh:path skos:example ] ;
    sh:targetSubjectsOf hov:documents .

hosh:SpokeShape a sh:NodeShape ;
    rdfs:label "Spoke completeness (demo)"@en ;
    sh:property [ sh:minCount 1 ;
            sh:path skos:example ],
        [ sh:minCount 1 ;
            sh:path dcterms:bibliographicCitation ],
        [ sh:minCount 1 ;
            sh:path skos:definition ],
        [ sh:minCount 1 ;
            sh:path hov:meaningAsOf ],
        [ sh:minCount 1 ;
            sh:path skos:inScheme ],
        [ sh:minCount 1 ;
            sh:path hov:discipline ],
        [ sh:minCount 1 ;
            sh:path hov:explanation ],
        [ sh:minCount 1 ;
            sh:path hov:citationVerification ] ;
    sh:targetSubjectsOf hov:assertedBy .

sh:NodeShape a owl:Class .

