  <rdf:Description rdf:about="https://example.org/harm-ontology/v3-editor-mini/soc#sacrificeZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/harm-ontology/v3-editor-mini/schema#SociologyTerm"/>
    <rdfs:label xml:lang="en">sacrifice zone</rdfs:label>
    <dcterms:bibliographicCitation xml:lang="en">Lerner, *Sacrifice Zones* (MIT Press, 2010)</dcterms:bibliographicCitation>
    <skos:altLabel xml:lang="en">sacrifice zone</skos:altLabel>
    <skos:altLabel xml:lang="en">tolerated cost</skos:altLabel>
    <skos:definition xml:lang="en">A place or community whose harm is accepted for others' benefit</skos:definition>
    <skos:example xml:lang="en">Communities near data centres bearing water and power costs (illustrative)</skos:example>
    <skos:historyNote xml:lang="en">Term from Cold War nuclear sites, applied to environmental justice</skos:historyNote>
    <skos:prefLabel xml:lang="en">sacrifice zone</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Geographic and community-bound</skos:scopeNote>
    <ho:assertedBy xml:lang="en">Sci-Fi Council</ho:assertedBy>
    <ho:citationVerification xml:lang="en">Sci-Fi review, `acceptedHarm` row</ho:citationVerification>
    <ho:discipline xml:lang="en">Sociology (environmental justice)</ho:discipline>
    <ho:explanation xml:lang="en">"Sacrifice zone" began as a term for Cold War nuclear sites and was taken up by the environmental justice movement for communities exposed to pollution so that others could benefit. Lerner's *Sacrifice Zones* (2010) documents such places in the United States. As a spoke, it is a narrower case of accepted harm: the tolerated cost falls on a particular place and the people who live there. It adds geography and distribution to the accepted kind. An accepted harm is rarely spread evenly; it is usually concentrated where the people bearing it have the least power to refuse. That connects the hub to the Power group, especially `costBearer`, `differentialBurden` and `whoseVoice`. For AI, the physical infrastructure of computation (data centres, power and water use, mining for hardware) raises the same pattern, though any specific claim about a specific place would need its own research before the book uses it. The example in the table is illustrative only.</ho:explanation>
    <ho:keyThinkers xml:lang="en">Steve Lerner</ho:keyThinkers>
    <ho:mappingGrade xml:lang="en">narrowMatch</ho:mappingGrade>
    <ho:mappingReason xml:lang="en">accepted harm located in places and communities</ho:mappingReason>
    <ho:mapsToProperty rdf:resource="https://example.org/harm-ontology/v3-editor-mini/schema#acceptedHarm"/>
    <ho:meaningAsOf xml:lang="en">2010</ho:meaningAsOf>
  </rdf:Description>
