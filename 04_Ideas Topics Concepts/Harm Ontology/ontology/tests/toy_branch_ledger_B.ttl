# Toy case "Branch ledger" — VARIANT B (assessment everywhere)
# FICTIONAL DATA. Not a claim about any real case. Test only (HO-002.a, 2026-11-18).

@prefix ho:   <https://example.org/harm-ontology/v3-test#> .
@prefix hoa:  <https://example.org/harm-ontology/v3-test/attr#> .
@prefix toy:  <https://example.org/harm-ontology/toy#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ---------- Bands ----------
ho:Low ho:bandRank 1 . ho:Medium ho:bandRank 2 . ho:High ho:bandRank 3 . ho:Extreme ho:bandRank 4 .

# ---------- Attribute concepts (hoa:) ----------
# Added after run 1: bands apply only to graded attributes; each attribute declares what it applies to.
hoa:severity      a ho:GradedAttribute ; ho:appliesTo ho:Effect .
hoa:cause         a ho:NonExclusiveAttribute ; ho:appliesTo ho:Effect .
hoa:answerable    a ho:NonExclusiveAttribute ; ho:appliesTo ho:Effect .
hoa:occurredStart ho:appliesTo ho:Effect .   # single-valued point: different years genuinely conflict
hoa:occurredDuring a ho:IntervalAttribute ; ho:appliesTo ho:Effect .  # "YYYY-YYYY": conflict only if disjoint
hoa:entityType    ho:appliesTo ho:AffectedEntity .

# ---------- Thin entities ----------
toy:F1 a ho:Factor ; rdfs:label "Software sync bug" .
toy:F2 a ho:Factor ; rdfs:label "Manager's slow manual reconciliation" .
toy:F3 a ho:Factor ; rdfs:label "Policy holding operators liable for shortfalls" .
toy:F4 a ho:Factor ; rdfs:label "Operator error" .

# Observable core per the triage: affects, occurredDuring (added after run 1: CQ8 needs `affects` in the core)
toy:E1 a ho:Effect ; rdfs:label "Financial loss to operators" ; ho:affects toy:AllOperators .
toy:E2 a ho:Effect ; rdfs:label "Reputational damage to operators" ; ho:affects toy:AllOperators ;
    ho:occurredStart "2009"^^xsd:gYear ; ho:occurredEnd "2014"^^xsd:gYear .
toy:E3 a ho:Effect ; rdfs:label "Stress-related illness among operators" ; ho:affects toy:AllOperators .  # TRAP: no assessments

toy:AllOperators  a ho:AffectedEntity ; rdfs:label "All branch operators" .
toy:SomeOperators a ho:AffectedEntity ; rdfs:label "Some branch operators" ; ho:subgroupOf toy:AllOperators .
toy:AidCircle     a ho:AffectedEntity ; rdfs:label "Operators' informal mutual-aid circle" .  # TRAP: unlisted kind

toy:CompanyX a ho:Agent ; rdfs:label "CompanyX" .
toy:Manager  a ho:Agent ; rdfs:label "Branch manager" .
toy:AuditFirmY a ho:Agent ; rdfs:label "Audit firm Y" .
toy:AuditFirmZ a ho:Agent ; rdfs:label "Audit firm Z" .
toy:Assoc  a ho:Agent ; rdfs:label "Operators' association" .
toy:Court  a ho:Agent ; rdfs:label "Appeal court" .

# ---------- Standards, traditions, procedures ----------
toy:StdContract a ho:EvaluativeStandard . toy:StdAudit a ho:EvaluativeStandard . toy:StdLegalCause a ho:EvaluativeStandard .
toy:ForensicAccounting a ho:PerspectiveType ; ho:defaultEvaluativeStandard toy:StdAudit .
toy:CorporateGovernance a ho:PerspectiveType ; ho:defaultEvaluativeStandard toy:StdContract .

toy:ProcInternal a ho:Procedure ; ho:version "1" ; ho:implementsStandard toy:StdContract ;
    ho:mapsValue [ ho:fromValue "2/10" ; ho:toBand ho:Low ] , [ ho:fromValue "4/10" ; ho:toBand ho:Medium ] ,
                 [ ho:fromValue "7/10" ; ho:toBand ho:High ] .
toy:ProcForensic a ho:Procedure ; ho:version "2" ; ho:implementsStandard toy:StdAudit ;
    ho:mapsValue [ ho:fromValue "mild" ; ho:toBand ho:Low ] , [ ho:fromValue "moderate" ; ho:toBand ho:Medium ] ,
                 [ ho:fromValue "serious" ; ho:toBand ho:High ] , [ ho:fromValue "critical" ; ho:toBand ho:Extreme ] .
toy:ProcCourt a ho:Procedure ; ho:version "1" ; ho:implementsStandard toy:StdLegalCause .
# Band mappings are made up for the toy case (decision 13).

# ---------- Perspective specifications ----------
toy:P1 a ho:PerspectiveSpecification ; rdfs:label "CompanyX internal review" ;
    ho:instantiates toy:CorporateGovernance ; ho:appliedEvaluativeStandard toy:StdContract ; ho:usesProcedure toy:ProcInternal .
toy:P2 a ho:PerspectiveSpecification ; rdfs:label "Forensic auditor 1 (firm Y)" ;
    ho:instantiates toy:ForensicAccounting ; ho:usesProcedure toy:ProcForensic .
toy:P3 a ho:PerspectiveSpecification ; rdfs:label "Forensic auditor 2 (firm Y, same firm)" ;
    ho:instantiates toy:ForensicAccounting ; ho:usesProcedure toy:ProcForensic .
toy:P4 a ho:PerspectiveSpecification ; rdfs:label "Operators' association (opinion)" .
toy:P5 a ho:PerspectiveSpecification ; rdfs:label "Appeal court" ;
    ho:appliedEvaluativeStandard toy:StdLegalCause ; ho:usesProcedure toy:ProcCourt .
toy:P6 a ho:PerspectiveSpecification ; rdfs:label "Forensic auditor 3 (firm Z)" ;
    ho:instantiates toy:ForensicAccounting ; ho:usesProcedure toy:ProcForensic .

# ---------- Assessments ----------
# Causal: who/what caused E1 (timeline for CQ4)
toy:C1 a ho:CausalAssessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:cause ; ho:value toy:F4 ;
    ho:takenFrom toy:P1 ; ho:assessorOrganisation toy:CompanyX ; ho:usesProcedure toy:ProcInternal ;
    ho:hasEvidence toy:Ev1 ; ho:assessedAt "2010-03-01"^^xsd:date ; ho:leftOut toy:F1 ; ho:omissionType ho:BlindSpot .
toy:C5 a ho:CausalAssessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:cause ; ho:value toy:F1 ;
    ho:takenFrom toy:P4 ; ho:assessorOrganisation toy:Assoc ; ho:assessedAt "2012-06-01"^^xsd:date .
toy:C2 a ho:CausalAssessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:cause ; ho:value toy:F1 ;
    ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ;
    ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:C6 a ho:CausalAssessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:cause ; ho:value toy:F1 ;
    ho:takenFrom toy:P3 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ;
    ho:hasEvidence toy:Ev2 ; ho:repeats toy:C2 ; ho:assessedAt "2016-01-10"^^xsd:date .
toy:C3 a ho:CausalAssessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:cause ; ho:value toy:F1 ;
    ho:takenFrom toy:P1 ; ho:assessorOrganisation toy:CompanyX ; ho:usesProcedure toy:ProcInternal ;
    ho:hasEvidence toy:Ev3 ; ho:revisedBecause toy:Ev3 ; ho:assessedAt "2018-09-01"^^xsd:date .
toy:C7 a ho:CausalAssessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:cause ; ho:value toy:F3 ;
    ho:takenFrom toy:P4 ; ho:assessorOrganisation toy:Assoc ; ho:assessedAt "2019-02-01"^^xsd:date .
toy:C4 a ho:CausalAssessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:cause ; ho:value toy:F1 ;
    ho:takenFrom toy:P5 ; ho:assessorOrganisation toy:Court ; ho:usesProcedure toy:ProcCourt ;
    ho:hasEvidence toy:Ev4 ; ho:assessedAt "2021-04-01"^^xsd:date .

# Severity of E1 (bands, overlapping scope, scope test)
toy:S1 a ho:Assessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:severity ; ho:value "4/10" ;
    ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P1 ; ho:assessorOrganisation toy:CompanyX ;
    ho:usesProcedure toy:ProcInternal ; ho:hasEvidence toy:Ev3 ; ho:assessedAt "2018-09-01"^^xsd:date .
toy:S2 a ho:Assessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ;
    ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ;
    ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:S3 a ho:Assessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ;
    ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P6 ; ho:assessorOrganisation toy:AuditFirmZ ;
    ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev5 ; ho:assessedAt "2016-03-01"^^xsd:date .
toy:S5 a ho:Assessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:severity ; ho:value ho:Low ;
    ho:forAffectedEntity toy:SomeOperators ; ho:takenFrom toy:P4 ; ho:assessorOrganisation toy:Assoc ;
    ho:assessedAt "2019-02-01"^^xsd:date .

# Severity of E2: two assessments, but P3 repeats P2 (same org) -> still SingleSource
toy:S6 a ho:Assessment ; ho:assesses toy:E2 ; ho:aboutAttribute hoa:severity ; ho:value "critical" ;
    ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ;
    ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:S8 a ho:Assessment ; ho:assesses toy:E2 ; ho:aboutAttribute hoa:severity ; ho:value "critical" ;
    ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P3 ; ho:assessorOrganisation toy:AuditFirmY ;
    ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev2 ; ho:repeats toy:S6 ; ho:assessedAt "2016-01-10"^^xsd:date .

# Severity of E3: unstandardized raw value without procedure -> Incommensurable
toy:S7 a ho:Assessment ; ho:assesses toy:E3 ; ho:aboutAttribute hoa:severity ; ho:value "moderate" ;
    ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P4 ; ho:assessorOrganisation toy:Assoc ;
    ho:assessedAt "2019-02-01"^^xsd:date .

# When E2 began (assessed reading of occurredDuring)
toy:T1 a ho:Assessment ; ho:assesses toy:E2 ; ho:aboutAttribute hoa:occurredStart ; ho:value "2012" ;
    ho:takenFrom toy:P1 ; ho:assessorOrganisation toy:CompanyX ; ho:usesProcedure toy:ProcInternal ;
    ho:hasEvidence toy:Ev3 ; ho:assessedAt "2018-09-01"^^xsd:date .
toy:T2 a ho:Assessment ; ho:assesses toy:E2 ; ho:aboutAttribute hoa:occurredStart ; ho:value "2009" ;
    ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ;
    ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .

# AffectedEntity type of an unlisted kind
toy:K1 a ho:Assessment ; ho:assesses toy:AidCircle ; ho:aboutAttribute hoa:entityType ; ho:value ho:Unclassified ;
    ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:assessedAt "2015-05-01"^^xsd:date .

# Responsibility (CQ9), kept apart from cause
toy:R1 a ho:ResponsibilityAssessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:answerable ; ho:value toy:Manager ;
    ho:takenFrom toy:P1 ; ho:assessorOrganisation toy:CompanyX ; ho:usesProcedure toy:ProcInternal ;
    ho:hasEvidence toy:Ev3 ; ho:assessedAt "2018-09-01"^^xsd:date .
toy:R2 a ho:ResponsibilityAssessment ; ho:assesses toy:E1 ; ho:aboutAttribute hoa:answerable ; ho:value toy:CompanyX ;
    ho:takenFrom toy:P5 ; ho:assessorOrganisation toy:Court ; ho:usesProcedure toy:ProcCourt ;
    ho:hasEvidence toy:Ev4 ; ho:assessedAt "2021-04-01"^^xsd:date .

# ---------- Toy run 2 additions (2026-11-18) ----------
# WHY: run 1 showed that naming different causes is NOT a conflict (HO-003: causes are additive).
# Non-exclusive attributes conflict only when an assessment (a) DENIES a value another one names
# (ho:deniesValue), or (b) claims a value is the ONLY one (ho:soleValue true) while others exist.
# E4 exercises (a); E5 exercises (b). Expected: both Disputed. E1 (no deny/sole) stays Corroborated.
toy:E4 a ho:Effect ; rdfs:label "TEST: cause denial" ; ho:affects toy:AllOperators .
toy:E5 a ho:Effect ; rdfs:label "TEST: sole-cause claim and disjoint dates" ; ho:affects toy:AllOperators .

# E4: P2 names F1; P4 names F3 AND explicitly denies F1 -> Disputed
toy:X1 a ho:CausalAssessment ; ho:assesses toy:E4 ; ho:aboutAttribute hoa:cause ; ho:value toy:F1 ;
    ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ;
    ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:X2 a ho:CausalAssessment ; ho:assesses toy:E4 ; ho:aboutAttribute hoa:cause ; ho:value toy:F3 ;
    ho:deniesValue toy:F1 ; ho:takenFrom toy:P4 ; ho:assessorOrganisation toy:Assoc ; ho:assessedAt "2019-02-01"^^xsd:date .

# E5: P2 says F1 is the ONLY cause; P5 names F3 -> Disputed (sole claim vs a second value)
toy:X3 a ho:CausalAssessment ; ho:assesses toy:E5 ; ho:aboutAttribute hoa:cause ; ho:value toy:F1 ;
    ho:soleValue true ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ;
    ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:X4 a ho:CausalAssessment ; ho:assesses toy:E5 ; ho:aboutAttribute hoa:cause ; ho:value toy:F3 ;
    ho:takenFrom toy:P5 ; ho:assessorOrganisation toy:Court ; ho:usesProcedure toy:ProcCourt ;
    ho:hasEvidence toy:Ev4 ; ho:assessedAt "2021-04-01"^^xsd:date .

# Date INTERVALS (finding 6): "YYYY-YYYY" values compare by overlap, not string equality.
# E2: 2009-2014 vs 2012-2014 overlap -> compatible (value narrows to the intersection 2012-2014).
toy:D1 a ho:Assessment ; ho:assesses toy:E2 ; ho:aboutAttribute hoa:occurredDuring ; ho:value "2009-2014" ;
    ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ;
    ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:D2 a ho:Assessment ; ho:assesses toy:E2 ; ho:aboutAttribute hoa:occurredDuring ; ho:value "2012-2014" ;
    ho:takenFrom toy:P1 ; ho:assessorOrganisation toy:CompanyX ; ho:usesProcedure toy:ProcInternal ;
    ho:hasEvidence toy:Ev3 ; ho:assessedAt "2018-09-01"^^xsd:date .
# E5: 2009-2010 vs 2012-2014 are disjoint -> Disputed
toy:D3 a ho:Assessment ; ho:assesses toy:E5 ; ho:aboutAttribute hoa:occurredDuring ; ho:value "2009-2010" ;
    ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ;
    ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:D4 a ho:Assessment ; ho:assesses toy:E5 ; ho:aboutAttribute hoa:occurredDuring ; ho:value "2012-2014" ;
    ho:takenFrom toy:P1 ; ho:assessorOrganisation toy:CompanyX ; ho:usesProcedure toy:ProcInternal ;
    ho:hasEvidence toy:Ev3 ; ho:assessedAt "2018-09-01"^^xsd:date .

# ---------- Toy run 3 additions (2026-11-18): section A of the pre-v3 test list ----------
# FICTIONAL. Perspectives P1..P6 are stand-ins (e.g. P5 "court" stands for a jurisdiction, P2 for an anthropologist).
# Nothing here is a claim about real law or real entities.

hoa:affectedStanding  ho:appliesTo ho:Effect .          # Direct | Derivative, per Effect x AffectedEntity (assessed)
hoa:moralCircleMember ho:appliesTo ho:AffectedEntity .  # assessed reading; the observed core is ho:affects
hoa:boundary          ho:appliesTo ho:AffectedEntity .  # who is inside a collective, as an assessment
hoa:sentience         ho:appliesTo ho:AffectedEntity .
ho:NaturalPerson rdfs:subClassOf ho:SentientIndividual .  # subtype vs supertype must NOT conflict

# --- Independence / settlement paths (all severity of an Effect, AllOperators, ProcForensic) ---
toy:E6 a ho:Effect ; rdfs:label "TEST: two perspectives, same firm, NOT marked repeats" ; ho:affects toy:AllOperators .
toy:E7 a ho:Effect ; rdfs:label "TEST: different firms, but second marked as repeating the first" ; ho:affects toy:AllOperators .
toy:E8 a ho:Effect ; rdfs:label "TEST: all forensic perspectives agree with evidence -> Settled" ; ho:affects toy:AllOperators .
toy:E9 a ho:Effect ; rdfs:label "TEST: agreement but one lacks evidence -> Corroborated" ; ho:affects toy:AllOperators .

# E6: P2 and P3 share a firm (strict independence needs different organisations) -> SingleSource
# N6a also leaves out an Effect (omission on a NON-causal attribute; CQ6).
toy:N6a a ho:Assessment ; ho:assesses toy:E6 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev2 ; ho:leftOut toy:E3 ; ho:omissionType ho:AcceptedHarm ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:N6b a ho:Assessment ; ho:assesses toy:E6 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P3 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev2 ; ho:assessedAt "2016-01-10"^^xsd:date .
# E7: different firms, but P6 is flagged as a repeat of P2 -> not independent -> SingleSource
toy:N7a a ho:Assessment ; ho:assesses toy:E7 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:N7b a ho:Assessment ; ho:assesses toy:E7 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P6 ; ho:assessorOrganisation toy:AuditFirmZ ; ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev5 ; ho:repeats toy:N7a ; ho:assessedAt "2016-03-01"^^xsd:date .
# E8: P2, P3, P6 (every perspective that uses ProcForensic) agree, all with evidence, two firms -> Settled(High)
toy:N8a a ho:Assessment ; ho:assesses toy:E8 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:N8b a ho:Assessment ; ho:assesses toy:E8 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P3 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev2 ; ho:assessedAt "2016-01-10"^^xsd:date .
toy:N8c a ho:Assessment ; ho:assesses toy:E8 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P6 ; ho:assessorOrganisation toy:AuditFirmZ ; ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev5 ; ho:assessedAt "2016-03-01"^^xsd:date .
# E9: as E8 but P3 gives no evidence pointer -> cannot settle -> Corroborated
toy:N9a a ho:Assessment ; ho:assesses toy:E9 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev2 ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:N9b a ho:Assessment ; ho:assesses toy:E9 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P3 ; ho:assessorOrganisation toy:AuditFirmY ; ho:usesProcedure toy:ProcForensic ; ho:assessedAt "2016-01-10"^^xsd:date .
toy:N9c a ho:Assessment ; ho:assesses toy:E9 ; ho:aboutAttribute hoa:severity ; ho:value "serious" ; ho:forAffectedEntity toy:AllOperators ; ho:takenFrom toy:P6 ; ho:assessorOrganisation toy:AuditFirmZ ; ho:usesProcedure toy:ProcForensic ; ho:hasEvidence toy:Ev5 ; ho:assessedAt "2016-03-01"^^xsd:date .

# --- Non-exclusive rule applied to `answerable` (finding 1 follow-up) ---
# E4: P1 says Manager; P5 says CompanyX and claims it is the ONLY answerable party -> Disputed (sole)
# E5: P1 says Manager; P5 says CompanyX and DENIES Manager -> Disputed (deny)
toy:R3 a ho:ResponsibilityAssessment ; ho:assesses toy:E4 ; ho:aboutAttribute hoa:answerable ; ho:value toy:Manager ; ho:takenFrom toy:P1 ; ho:assessorOrganisation toy:CompanyX ; ho:assessedAt "2018-09-01"^^xsd:date .
toy:R4 a ho:ResponsibilityAssessment ; ho:assesses toy:E4 ; ho:aboutAttribute hoa:answerable ; ho:value toy:CompanyX ; ho:soleValue true ; ho:takenFrom toy:P5 ; ho:assessorOrganisation toy:Court ; ho:assessedAt "2021-04-01"^^xsd:date .
toy:R5 a ho:ResponsibilityAssessment ; ho:assesses toy:E5 ; ho:aboutAttribute hoa:answerable ; ho:value toy:Manager ; ho:takenFrom toy:P1 ; ho:assessorOrganisation toy:CompanyX ; ho:assessedAt "2018-09-01"^^xsd:date .
toy:R6 a ho:ResponsibilityAssessment ; ho:assesses toy:E5 ; ho:aboutAttribute hoa:answerable ; ho:value toy:CompanyX ; ho:deniesValue toy:Manager ; ho:takenFrom toy:P5 ; ho:assessorOrganisation toy:Court ; ho:assessedAt "2021-04-01"^^xsd:date .

# --- CQ7 cases: AffectedEntity type, standing, boundary, moral circle (entity kinds are made-up stand-ins) ---
toy:Tribe1 a ho:AffectedEntity ; rdfs:label "TEST: a tribe" .
toy:Grid1 a ho:AffectedEntity , ho:Factor ; rdfs:label "TEST: electric grid (an AffectedEntity AND a Factor)" .
toy:AISys1 a ho:AffectedEntity ; rdfs:label "TEST: an AI system" .
toy:Dog1 a ho:AffectedEntity ; rdfs:label "TEST: an animal" .
toy:Herd1 a ho:AffectedEntity ; rdfs:label "TEST: a herd / population (collective, not an individual)" .
toy:Couple1 a ho:AffectedEntity ; rdfs:label "TEST: a couple (a Relationship)" .
toy:Partner1 a ho:AffectedEntity ; rdfs:label "TEST: partner 1" .
toy:Partner2 a ho:AffectedEntity ; rdfs:label "TEST: partner 2" .
toy:Household1 a ho:AffectedEntity ; rdfs:label "TEST: a status-defined household (joint filers)" .
toy:Partnership1 a ho:AffectedEntity ; rdfs:label "TEST: a business partnership" .
toy:LLC1 a ho:AffectedEntity ; rdfs:label "TEST: an LLC" .
toy:Person1 a ho:AffectedEntity ; rdfs:label "TEST: a person (subtype vs supertype)" .
toy:Collective2 a ho:AffectedEntity ; rdfs:label "TEST: Unclassified vs a specific type" .

toy:E11 a ho:Effect ; rdfs:label "TEST: grid outage" ; ho:affects toy:Grid1 , toy:AISys1 .
toy:E12 a ho:Effect ; rdfs:label "TEST: couple harmed by poor therapy" ; ho:affects toy:Couple1 .
toy:E13 a ho:Effect ; rdfs:label "TEST: therapy harm to partner 1 (separate Effect)" ; ho:affects toy:Partner1 .
toy:E14 a ho:Effect ; rdfs:label "TEST: therapy harm to partner 2 (separate Effect)" ; ho:affects toy:Partner2 .
toy:E15 a ho:Effect ; rdfs:label "TEST: marriage tax penalty" ; ho:affects toy:Household1 .

# Type of entity (exclusive attribute). Tribe: social group (P2, anthropology) vs legal entity (P5) -> Disputed.
toy:Y1 a ho:Assessment ; ho:assesses toy:Tribe1 ; ho:aboutAttribute hoa:entityType ; ho:value ho:CollectiveNaturalGroup ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:Y2 a ho:Assessment ; ho:assesses toy:Tribe1 ; ho:aboutAttribute hoa:entityType ; ho:value ho:CollectiveArtificialPerson ; ho:takenFrom toy:P5 ; ho:assessorOrganisation toy:Court ; ho:assessedAt "2021-04-01"^^xsd:date .
# Tribe boundary as an assessment with its perspective -> Disputed
toy:Y3 a ho:Assessment ; ho:assesses toy:Tribe1 ; ho:aboutAttribute hoa:boundary ; ho:value "ClanA" ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:assessedAt "2015-05-01"^^xsd:date .
toy:Y4 a ho:Assessment ; ho:assesses toy:Tribe1 ; ho:aboutAttribute hoa:boundary ; ho:value "ClansAandB" ; ho:takenFrom toy:P5 ; ho:assessorOrganisation toy:Court ; ho:assessedAt "2021-04-01"^^xsd:date .
# Animal: an individual; sentience assessed per perspective. A herd is a collective, not an individual.
toy:Y5 a ho:Assessment ; ho:assesses toy:Dog1 ; ho:aboutAttribute hoa:entityType ; ho:value ho:SentientIndividual ; ho:takenFrom toy:P2 ; ho:assessorOrganisation toy:AuditFirmY ; ho:assessedAt "2015-05-01"^^xsd:date .
