  <rdf:Description rdf:about="https://example.org/harm-ontology/v3-editor-mini/schema#verificationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">verificationStatus</rdfs:label>
