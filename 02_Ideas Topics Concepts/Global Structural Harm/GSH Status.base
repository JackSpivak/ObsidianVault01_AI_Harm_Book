formulas:
  problem: 'if(fileClass != "Idea", "missing fileClass: Idea · ", "") + if(!["stub", "seed", "developing", "stable", "archived"].contains(status), "status not an allowed value · ", "") + if(!(bookmark == "draft" || bookmark == "ready" || /^[A-Za-z0-9-]+-\d{3}[a-z]?$/.matches(bookmark) || /^\d{3}[a-z]?$/.matches(bookmark)), "bookmark not draft/ready/an index ID · ", "") + if(!["new", "revisited"].contains(territory), "territory not new/revisited · ", "") + if(territory == "revisited" && !revisits, "revisited but no revisits link", "")'
properties:
  formula.problem:
    displayName: Problem
views:
  - type: table
    name: GSH notes
    filters:
      and:
        - file.inFolder("02_Ideas Topics Concepts/Global Structural Harm")
        - type == "idea"
    order:
      - bookmark
      - file.name
      - status
      - tags
      - created
    sort:
      - property: bookmark
        direction: ASC
  - type: table
    name: Unfiled inbox (all ideas)
    filters:
      or:
        - bookmark == "draft"
        - bookmark == "ready"
    order:
      - file.name
      - bookmark
      - status
      - file.folder
      - created
  - type: table
    name: Problems (all ideas)
    filters:
      and:
        - type == "idea"
        - or:
            - '!["stub", "seed", "developing", "stable", "archived"].contains(status)'
            - '!(bookmark == "draft" || bookmark == "ready" || /^[A-Za-z0-9-]+-\d{3}[a-z]?$/.matches(bookmark) || /^\d{3}[a-z]?$/.matches(bookmark))'
            - '!["new", "revisited"].contains(territory)'
            - fileClass != "Idea"
            - territory == "revisited" && !revisits
    order:
      - file.name
      - formula.problem
      - status
      - bookmark
      - territory
      - fileClass
      - file.folder
    columnSize:
      formula.problem: 336
