    dcterms:source "PerspectiveStructure 0.02, group 11"@en ;
    rdfs:comment "corroboration · calibration + uncertainty · anomalies · orderOfMagnitude"@en ;
    rdfs:domain ho:PerspectiveType ;
    rdfs:range ho:Assessment ;
    rdfs:subPropertyOf ho:grp_11_obj ;
    ho:designStatus "proposed (kind and range assigned by the builder; to be reviewed)"@en ;
    ho:displayGroup "11 ASSESSMENTS (each an Assessment with assessedBy -> PerspectiveType)"@en .

