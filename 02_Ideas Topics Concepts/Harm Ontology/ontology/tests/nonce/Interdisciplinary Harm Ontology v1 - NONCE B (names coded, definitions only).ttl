harm:H-002 a owl:Class,
        skos:Concept ;
    harm:H-003 harm:H-004 ;
    harm:H-005 harm:H-006 ;
    harm:H-007 harm:H-008 ;
    rdfs:subClassOf harm:H-001 ;
    skos:broader harm:H-001 ;
    skos:definition "At the highest level, this domain defines harm strictly through conscious, subjective phenomenology—negative mental or physical states experienced directly by a sentient subject."@en .

harm:H-033 a harm:H-124,
        skos:Concept .

harm:H-031 a harm:H-122,
        skos:Concept .

harm:H-032 a harm:H-123,
